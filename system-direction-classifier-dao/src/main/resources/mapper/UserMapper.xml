<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.whu.irlab.systemdirectionclassifier.dao.database.mapper.UserMapper">

	<resultMap id="dbResultMap"
			   type="cn.edu.whu.irlab.systemdirectionclassifier.dao.database.dataobject.UserDO">
		<result column="id" property="id"/>
		<result column="login" property="login"/>
		<result column="email" property="email"/>
		<result column="password_hash" property="passwordHash"/>
		<result column="display_name" property="displayName"/>
		<result column="phone" property="phone"/>
		<result column="avatar_url" property="avatarUrl"/>
		<result column="organization" property="organization"/>
		<result column="department" property="department"/>
		<result column="lang_key" property="langKey"/>
		<result column="preferences" property="preferences"/>
		<result column="last_login_at" property="lastLoginAt"/>
		<result column="last_login_ip" property="lastLoginIp"/>
		<result column="remark" property="remark"/>
		<result column="created_by" property="createdBy"/>
		<result column="updated_by" property="updatedBy"/>
		<result column="status" property="status"/>
		<result column="created_at" property="createdDate"/>
		<result column="updated_at" property="lastModifiedDate"/>
	</resultMap>

	<sql id="baseColumns">
		id, login, display_name, email, password_hash, phone, avatar_url, organization,
		department, lang_key, preferences, last_login_at, last_login_ip, remark,
		status, created_by, updated_by, created_at, updated_at
	</sql>

	<select id="selectPage"
			resultMap="dbResultMap">
		SELECT <include refid="baseColumns"/>
		FROM demo_user
		<include refid="selectPageCondition"/>
	</select>

	<sql id="selectPageCondition">
		<where>
			<if test="login != null and login != ''">
				AND login = #{login}
			</if>
		</where>
	</sql>

	<select id="selectByLogin" resultMap="dbResultMap">
		SELECT <include refid="baseColumns"/>
		FROM demo_user
		WHERE login = #{login}
	</select>

	<select id="selectByEmail" resultMap="dbResultMap">
		SELECT <include refid="baseColumns"/>
		FROM demo_user
		WHERE email = #{email}
	</select>

	<select id="countByLogin" resultType="int">
		SELECT COUNT(1)
		FROM demo_user
		WHERE login = #{login}
	</select>

	<select id="countByEmail" resultType="int">
		SELECT COUNT(1)
		FROM demo_user
		WHERE email = #{email}
	</select>

	<select id="countByEmailExcludeUser" resultType="int">
		SELECT COUNT(1)
		FROM demo_user
		WHERE email = #{email}
		AND id != #{excludeUserId}
	</select>

</mapper>
