@startuml

!if %variable_exists("$THEME")
title 阿里巴巴分层应用架构组件图 - $THEME theme
!else
title 阿里巴巴分层应用架构组件图
!endif

'skinparam BackgroundColor transparent

[system-direction-classifier-web] <<请求处理层>>
[system-direction-classifier-api] <<API层>>
[system-direction-classifier-service] <<业务逻辑服务层>>
[system-direction-classifier-manager] <<通用业务处理层>>
[system-direction-classifier-dao] <<数据持久层>>
[system-direction-classifier-start] <<启动入口>>

[system-direction-classifier-start] --> [system-direction-classifier-web]
[system-direction-classifier-web] --> [system-direction-classifier-api]: 暴露接口
[system-direction-classifier-web] --> [system-direction-classifier-service]: JVM调用
[system-direction-classifier-service] --> [system-direction-classifier-api]: 实现接口
[system-direction-classifier-service] --> [system-direction-classifier-dao]: 数据操作
[system-direction-classifier-service] --> [system-direction-classifier-manager]: 业务编排
[system-direction-classifier-manager] --> [system-direction-classifier-dao]: 通用DAO封装

node "APP终端" <<主动适配器>>
cloud "RPC调用方" <<主动适配器>>
control "Job调度平台" <<主动适配器>>
queue "MQ消息队列" <<主动适配器>>

cloud "第三方接口" <<被动驱动器>>
database "MySQL" <<被动驱动器>>
database "Redis" <<被动驱动器>>
database "MQ" <<被动驱动器>>
database "Elasticsearch" <<被动驱动器>>
database "MongoDB" <<被动驱动器>>

http -r- [system-direction-classifier-web]: REST 接口
[APP终端] .d.> http: 前后端对接
[system-direction-classifier-service] -u-> rpc: RPC 接口
[RPC调用方] ..> rpc: 调用
[RPC调用方] ..> [system-direction-classifier-api]: 代码集成
[Job调度平台] <.d.> [system-direction-classifier-manager]: 任务调度
[system-direction-classifier-manager] <.u.> [MQ消息队列]: 消费消息

[system-direction-classifier-dao] .d.> MySQL: 读写数据
[system-direction-classifier-dao] .d.> Elasticsearch: 读写索引
[system-direction-classifier-dao] .d.> MongoDB: 读写数据
[system-direction-classifier-manager] .d.> MQ: 生产消息
[system-direction-classifier-manager] .d.> Redis: 缓存管理
[system-direction-classifier-manager] .d.> 第三方接口: 封装SDK

skinparam component {
 	backgroundColor<<请求处理层>> LightGreen
    backgroundColor<<业务逻辑服务层>> LightGreen
    backgroundColor<<通用业务处理层>> LightGreen
    backgroundColor<<数据持久层>> LightGreen
    backgroundColor<<启动入口>> LightGreen
    backgroundColor<<API层>> Khaki
}

skinparam cloud {
    backgroundColor<<主动适配器>> SkyBlue
    backgroundColor<<被动驱动器>> Pink
}

skinparam database {
    backgroundColor<<主动适配器>> SkyBlue
    backgroundColor<<被动驱动器>> Pink
}

skinparam queue {
    backgroundColor<<主动适配器>> SkyBlue
    backgroundColor<<被动驱动器>> Pink
}

skinparam control {
    backgroundColor<<主动适配器>> SkyBlue
    backgroundColor<<被动驱动器>> Pink
}

skinparam node {
    backgroundColor<<主动适配器>> SkyBlue
    backgroundColor<<被动驱动器>> Pink
}

@enduml
